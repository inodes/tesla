def listing():
    out = ["Usage: ./tesla <group> <command> [options]     (-h after a command for its own help)", ""]
    for g, title, cmds in GROUPS:
        out.append("%s - %s" % (g, title))
        for c, _s, what in cmds:
            out.append("    %-22s %s" % (c, what))
        out.append("")
    out.append("One-off tools: Tools/maintenance/.  The app: Tools/tesla_app.py.")
    return "\n".join(out)


def find(args):
    """(script, the rest of the arguments) for these arguments, or (None, message)."""
    if args and (args[0].endswith(".py") or args[0].endswith(".sh")):        # an old script name
        name = os.path.basename(args[0])
        if os.path.isfile(os.path.join(CMDS, name)):
            return name, args[1:]
        return None, "No command script named %s." % name
    if len(args) < 2:
        g = args[0] if args else None
        for gg, title, cmds in GROUPS:
            if gg == g:
                return None, "%s - %s:\n" % (gg, title) + "\n".join("    %-22s %s" % (c, w) for c, _s, w in cmds)
        return None, listing()
    for gg, _t, cmds in GROUPS:
        if gg == args[0]:
            for c, s, _w in cmds:
                if c == args[1]:
                    return s, args[2:]
            return None, "No command '%s' in %s. %s commands: %s" % (args[1], gg, gg, ", ".join(c for c, _s, _w in cmds))
    return None, "No group '%s'.\n\n%s" % (args[0], listing())


def main(argv):
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip() + "\n\n" + listing())
        return 0
    script, rest = find(argv)
    if not script:
        print(rest)
        return 0 if not argv else 2
    path = os.path.join(CMDS, script)
    cmd = (["bash", path] if script.endswith(".sh") else [sys.executable, path]) + list(rest)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
