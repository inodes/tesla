{
  "_comment": "Copy to config.json and edit. Every key is explained in docs/CONFIG.md; keep passwords and API keys in config.json only.",
  "directories": {
    "landing": "~/Downloads",
    "inbox": "~/Library/Mobile Documents/com~apple~CloudDocs/Tesla/Inbox",
    "data": "~/Library/Mobile Documents/com~apple~CloudDocs/Tesla",
    "archive": null,
    "invoices": "~/iCloud/PDF/Tesla/Supercharging",
    "power_invoices": "~/iCloud/PDF/AGL",
    "external_drive": null
  },
  "tessie": {
    "vin": "YOUR_VIN_HERE",
    "access_token": "YOUR_TESSIE_API_TOKEN_HERE"
  },
  "evnex": {
    "username": "YOUR_EVNEX_ACCOUNT_EMAIL_HERE",
    "password": "YOUR_EVNEX_ACCOUNT_PASSWORD_HERE"
  },
  "pvoutput": {
    "api_key": "YOUR_PVOUTPUT_API_KEY_HERE",
    "system_id": "YOUR_PVOUTPUT_SYSTEM_ID_HERE"
  },
  "power": {
    "provider": "agl",
    "usage_staleness_days": 14
  },
  "reconciliation": {
    "tolerance_mins": 45,
    "tolerance_kwh": 5.0,
    "auto_consolidate": false
  },
  "tariffs": {
    "default_currency": "AUD"
  },
  "default_comparison_vehicle": "mazda_cx8_diesel",
  "abrp": {
    "client_id": "YOUR_ABRP_CLIENT_ID_HERE",
    "api_key": "YOUR_ABRP_APPLICATION_API_KEY_HERE",
    "user_token": "YOUR_ABRP_GENERIC_USER_TOKEN_HERE",
    "target_arrival_soc": 10,
    "max_charge_soc": 80,
    "corridor_radius_km": 5.0
  },
  "osm": {
    "client_id": "YOUR_OSM_OAUTH2_CLIENT_ID_HERE",
    "client_secret": "YOUR_OSM_OAUTH2_CLIENT_SECRET_HERE",
    "redirect_uri": "urn:ietf:wg:oauth:2.0:oob"
  },
  "solaredge": {
    "api_key": "YOUR_SOLAREDGE_MONITORING_API_KEY_HERE",
    "site_id": "YOUR_SOLAREDGE_SITE_ID_HERE",
    "client_id": "YOUR_SOLAREDGE_V2_CLIENT_ID_HERE",
    "client_secret": "YOUR_SOLAREDGE_V2_CLIENT_SECRET_HERE"
  },
  "pv": {
    "provider": "solaredge"
  },
  "software": {
    "_comment": "Tesla software version tracker (Teslascope's public API, no token). regions: a name -> country codes; labels turn Teslascope's car type ids into names.",
    "regions": {"ANZ": ["au", "nz"], "North America": ["us", "ca", "mx", "pr"], "United Kingdom and Ireland": ["gb", "ie"]},
    "my_car": {"model": "modely", "hw": "TeslaAP4"},
    "settle_days": 14,
    "refetch_hours": 6,
    "pace_seconds": 1.0
  },
  "app": {
    "_comment": "Settings of Tools/tesla_app.py, drive_report.py and the places lookups (lib/app_config.py). Every value is optional: delete any you do not want to change and the default applies. map.style_light/style_dark: an OpenFreeMap style (positron, dark, liberty = 3D, bright, fiord). drives.repark_*: a drive shorter than both is a re-park (the car was only shuffled). nearby.*: Overpass servers/time limits and the Photon fallback for 'what is around here'. places.save_radius_*: when you save a place from an OpenStreetMap result, the radius is at least min_m and otherwise reaches every stop the car recorded within cluster_m of the stop, plus margin_m.",
    "timezone": "Australia/Sydney",
    "clock": { "match_km": 0.5, "margin_km": 1.0, "reuse_hours": 36 },
    "map": {
      "tiles_base": "https://tiles.openfreemap.org/styles/",
      "style_light": "positron",
      "style_dark": "dark",
      "places_max_lon": 160,
      "speed_colors": [[0, "#1565C0"], [40, "#00ACC1"], [50, "#26C6DA"], [60, "#43A047"], [70, "#9CCC65"], [80, "#FDD835"], [90, "#FFB300"], [100, "#FB8C00"], [110, "#E53935"], [120, "#B71C1C"], [130, "#8E24AA"]],
      "speed_over_color": "#000000",
      "autopilot_colors": {"FSD": "#3b6cf6", "Autosteer": "#8b5cf6", "TACC": "#14b8a6", "Manual": "#94a3b8"},
      "network_colors": {
        "Tesla": "#e0201b",
        "Tesla Destination": "#f97316",
        "Chargefox": "#16a34a",
        "Evie": "#7c3aed",
        "EVX": "#eab308",
        "Exploren": "#db2777",
        "NRMA": "#2563eb",
        "AmpCharge": "#84cc16",
        "Jolt": "#14b8a6",
        "BP Pulse": "#0891b2",
        "3rd-Party": "#6b7280",
        "WA EV Network": "#9333ea"
      }
    },
    "drives": {
      "repark_max_km": 0.05,
      "repark_max_minutes": 10,
      "join_gap_s": 120,
      "long_highway_km": 30,
      "long_highway_fast_kmh": 90,
      "long_highway_fast_minutes": 10,
      "charge_window_minutes": 30,
      "range_days_shown": 31,
      "low_battery_pct": 20
    },
    "places": {
      "stay_min_seconds": 120,
      "save_radius_min_m": 100,
      "save_radius_margin_m": 25,
      "save_radius_cluster_m": 250
    },
    "nearby": {
      "overpass_endpoints": [
        "https://overpass.kumi.systems/api/interpreter",
        "https://overpass.private.coffee/api/interpreter",
        "https://overpass.openstreetmap.fr/api/interpreter",
        "https://lz4.overpass-api.de/api/interpreter",
        "https://overpass-api.de/api/interpreter"
      ],
      "overpass_total_timeout_s": 20,
      "overpass_server_timeout_s": 8,
      "photon_url": "https://photon.komoot.io/reverse",
      "photon_limit": 50
    },
    "window": {
      "width": 1440,
      "height": 940,
      "port": 8765
    },
    "teslacam": {
      "moving_kmh": 3.0,
      "run_gap_s": 75,
      "gap_min_s": 120,
      "same_place_m": 300,
      "same_place_est_m": 800,
      "same_minute_s": 30,
      "read_workers": 4,
      "days_newest_first": true,
      "rows_newest_first": false
    },
    "review": {
      "step_s": 1.0,
      "min_kmh": 30.0,
      "min_conf": 50.0,
      "workers": 3,
      "merge_s": 12.0,
      "crop_px": 320,
      "refine_step_s": 0.2,
      "refine_pad_s": 2.0,
      "refine_conf": 85.0,
      "candidate_km": 20,
      "candidate_avg_kmh": 60,
      "accel_min_pct": 5,
      "speed_from": 100,
      "speed_to": 110,
      "speed_tol_kmh": 3,
      "speed_hold_s": 8,
      "speed_window_s": 90,
      "event_before_s": 12,
      "event_after_s": 15,
      "max_event_stills": 40,
      "steer_deg": 15,
      "sheet_cols": 7,
      "sheet_tile_px": 240
    },
    "stills": {
      "width": 400,
      "quality": 6,
      "workers": 3,
      "thin_width": 240,
      "thin_quality": 10
    },
    "event_shots": {
      "quality": 2
    }
  }
}
