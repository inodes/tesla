# Add Tools directory to PATH for convenient CLI command execution
PATH_add Tools
PATH_add dashcam
PATH_add Tessie

# Detect stale/moved virtualenvs from old locations (e.g. iCloud repo path)
if [ -d ".direnv" ]; then
  for venv_cfg in .direnv/*/pyvenv.cfg; do
    if [ -f "$venv_cfg" ]; then
      if ! grep -q "$PWD" "$venv_cfg" 2>/dev/null; then
        echo "⚠️  [direnv] Detected stale/moved virtualenv in $(dirname "$venv_cfg"). Removing..."
        rm -rf "$(dirname "$venv_cfg")"
      fi
    fi
  done
fi

# Per-directory isolated Python virtualenv using pyenv
layout python

# Automatically install and sync requirements.txt on change or if dependencies missing
if [ -f requirements.txt ]; then
  watch_file requirements.txt
  if [ -n "$VIRTUAL_ENV" ]; then
    REQ_HASH_FILE="$VIRTUAL_ENV/.requirements.sha256"
    CURRENT_HASH=$(shasum -a 256 requirements.txt | awk '{print $1}')
    
    NEEDS_INSTALL=0
    if [ ! -f "$REQ_HASH_FILE" ] || [ "$(cat "$REQ_HASH_FILE" 2>/dev/null)" != "$CURRENT_HASH" ]; then
      NEEDS_INSTALL=1
    elif ! python -c "import playwright, playwright_stealth, pypdf, pdfplumber" 2>/dev/null; then
      NEEDS_INSTALL=1
    fi

    if [ "$NEEDS_INSTALL" -eq 1 ]; then
      echo "📦 [direnv] Installing / syncing dependencies from requirements.txt..."
      python -m pip install -r requirements.txt
      echo "$CURRENT_HASH" > "$REQ_HASH_FILE"
      
      # Auto-install Playwright browser binaries if playwright is present
      if python -c "import playwright" 2>/dev/null; then
        python -m playwright install webkit chromium
      fi
    fi
  fi
fi
