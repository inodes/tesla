# Add Tools directory to PATH for convenient CLI command execution
PATH_add Tools
PATH_add dashcam
PATH_add Tessie

# Per-directory isolated Python virtualenv using pyenv
layout python

# Automatically install and sync requirements.txt on change
if [ -f requirements.txt ]; then
  watch_file requirements.txt
  REQ_HASH_FILE="$VIRTUAL_ENV/.requirements.sha256"
  CURRENT_HASH=$(shasum -a 256 requirements.txt | awk '{print $1}')
  
  if [ ! -f "$REQ_HASH_FILE" ] || [ "$(cat "$REQ_HASH_FILE" 2>/dev/null)" != "$CURRENT_HASH" ]; then
    echo "📦 [direnv] Installing / syncing dependencies from requirements.txt..."
    pip install -r requirements.txt
    echo "$CURRENT_HASH" > "$REQ_HASH_FILE"
    
    # Auto-install Playwright browser binaries if playwright is present
    if python -c "import playwright" 2>/dev/null; then
      playwright install webkit chromium
    fi
  fi
fi
